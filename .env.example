# Template for the docker compose stack (compose.yaml at the repo root).
# Copy to .env and fill in the values. .env is gitignored and must never be committed.
# The API's own local (non-compose) template is packages/api/.env.example.

# Local only. The postgres superuser password used by the postgres and migrate services.
POSTGRES_PASSWORD=postgres

# Auth0 tenant and API identifier the api service verifies tokens against.
# If you use packages/api/scripts/dev-token.mjs, these must match the values it signs with
# (run it with the same AUTH0_DOMAIN and AUTH0_AUDIENCE).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

CORS_ORIGIN=http://localhost:3000

# Optional: local public key set so the api accepts tokens minted by dev-token.mjs.
# Never set under production (the api refuses to start).
# AUTH_TEST_JWKS='<single-line output of: node packages/api/scripts/dev-token.mjs --print-jwks>'
