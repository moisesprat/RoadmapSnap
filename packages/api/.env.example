# Required. One of development, test or production; the API refuses to start without it.
NODE_ENV=development
# Port the API listens on.
PORT=4000
# Owner role. Read only by npm run migrate and npm run seed:dev, never by the API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadmapsnap_dev
# The only database URL the API uses. Must be the NOSUPERUSER roadmapsnap_app role (known Phase 7 DEP-02 password debt).
APP_DATABASE_URL=postgresql://roadmapsnap_app:apppassword@localhost:5432/roadmapsnap_dev
# Maximum connections in the API pool.
APP_DB_POOL_MAX=10
# Auth0 tenant domain (for example your-tenant.eu.auth0.com).
AUTH0_DOMAIN=
# Auth0 API identifier the access tokens are issued for.
AUTH0_AUDIENCE=
# Browser origin allowed by CORS. Required when NODE_ENV=production; development and test fall back to http://localhost:3000.
CORS_ORIGIN=http://localhost:3000
# Local JWKS JSON for tests and scripted local use. Refused when NODE_ENV=production.
# AUTH_TEST_JWKS=
# seed:dev defaults: Auth0 subject and email of the developer who becomes admin of Demo Org A.
DEV_ADMIN_SUB=
DEV_ADMIN_EMAIL=dev-admin@local.dev
