{
  "name": "roadmapsnap",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js packages/core/tests/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js packages/core/tests/*.test.js",
    "validate": "node scripts/validate-config.mjs",
    "docs": "node scripts/generate-docs.mjs",
    "dev": "vite",
    "build": "vite build && mkdir -p dist/js && cp js/config.js dist/js/",
    "build:check": "vite build && node scripts/generate-docs.mjs && mkdir -p dist/js && cp js/config.js dist/js/ && echo \"Build + docs succeeded\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "vite": "^7.3.1"
  }
}
